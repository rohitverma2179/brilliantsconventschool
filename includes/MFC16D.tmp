function get_banner_matrix($ary)
{
	if(sizeof($ary)==0)
	{
		return "";
	}
	global $SVP;
	$cols=4;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","banner_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockTopBannerMatrixList', 'ABlockList');
	$i=0;
	foreach($ary as $k=>$v)
	{	
		$m=$i%$cols;
	
		$t->set_var(array("banner_matrix_".$i%$cols=>get_banner_source($v),
						  "box_".$m."_1"=>'<img src="images/top_box/top_left.jpg" width="26" height="24"/>',
						  "box_".$m."_2"=>'style="background:url(images/top_box/top_bg.jpg) repeat-x"',
						  "box_".$m."_3"=>'<img src="images/top_box/top_right.jpg" width="26" height="24"/>',
						  "box_".$m."_4"=>'style="background:url(images/top_box/left_line_bg.jpg) repeat-y"',
						  "box_".$m."_5"=>'<img src="images/top_box/left_line.jpg" width="26" height="94"/>',
						  "box_".$m."_6"=>'style="background:url(images/top_box/bg.jpg) repeat-x"',
						  "box_".$m."_7"=>'style="background:url(images/top_box/right_line_bg.jpg) repeat-y"',
						  "box_".$m."_8"=>'<img src="images/top_box/right_line.jpg" width="26" height="94"/>',
						  "box_".$m."_9"=>'<img src="images/top_box/bottom_left.jpg" width="26" height="26"/>',
						  "box_".$m."_10"=>'style="background:url(images/top_box/bottom_bg.jpg) repeat-x"',
						  "box_".$m."_11"=>'<img src="images/top_box/bottom_right.jpg" width="26" height="26"/>',
					));
		if($i%$cols==$cols_ AND $i>0)
		{
			
			$t->Parse('ABlockList', 'AccessBlockTopBannerMatrixList', true);		
		}
		$i++;
	}
	if($i>0 AND $i%$cols!=0)
	{
		for($j=$i;$i>0;$j++)
		{	
			$k=$j%$cols;
			$t->set_var(array("banner_matrix_".$j%$cols=>"",
							  "box_".$k."_1"=>"",
							  "box_".$k."_2"=>"",
							  "box_".$k."_3"=>"",
							  "box_".$k."_4"=>"",
							  "box_".$k."_5"=>"",
							  "box_".$k."_6"=>"",
							  "box_".$k."_7"=>"",
							  "box_".$k."_8"=>"",
							  "box_".$k."_9"=>"",
							  "box_".$k."_10"=>"",
							  "box_".$k."_11"=>"",
							  ));
			if($j%$cols==$cols_)
			{
				$t->Parse('ABlockList', 'AccessBlockTopBannerMatrixList', true);	
				$i=0;
			}
		}
	}
	
	$t->set_var(array("title"=>$title,
					  "SVP"=>$SVP,
						));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
