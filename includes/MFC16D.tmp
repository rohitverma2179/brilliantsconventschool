function get_category_matrix($ary)
{
	if(sizeof($ary)==0)
	{
		return "";
	}

	global $SVP;
	$cols=4;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","category_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockCategoryMatrixList', 'ABlockList');

	$i=0;
	foreach($ary as $k=>$v)
	{
		$m=$i%$cols;
			$t->set_var(array("cat_matrix_".$i%$cols=>get_category_source($v),
							  "cbox_".$m=>'background:url(images/top_box_bg.png) no-repeat;',
							 ));
							  						  
		if($i%$cols==$cols_ AND $i>0)
		{
			$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);		
		}
		$i++;
	}
	if($i>0 AND $i%$cols!=0)
	{
		for($j=$i;$i>0;$j++)
		{
			$k=$j%$cols;
			$t->set_var(array("cat_matrix_".$j%$cols=>"",
							  "cbox_".$k=>"style='display:none'",
							  ));
			if($j%$cols==$cols_)
			{
				$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);	
				$i=0;
			}
		}
	}
	$t->set_var(array("title"=>$title,
					  "SVP"=>$SVP,
						));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
#####################################

function get_category_source($cat_id)
{
	global $SVP;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","category_source.htm");
	gri("category","WHERE cat_id='$cat_id' AND cat_active='1'","",$cat);
	$cat[cat_title]=short_txt($cat[cat_title],40);
	$cat[CPT1]="<!--";	$cat[CPT2]="-->";
	$cat[CDT1]="<!--";	$cat[CDT2]="-->";
	$cat[CDT3]="";	$cat[CDT4]="";
	if($cat[cat_chk_display_price]==1 && $cat[cat_display_price]!="")
	{
		$cat[CPT1]="";	$cat[CPT2]="";
	}
	if($cat[cat_chk_display_text]==1 && $cat[cat_display_text]!="")
	{
		$cat[CDT1]="";	$cat[CDT2]="";
	}
	if($cat[CPT1]=="<!--" && $cat[CDT1]=="<!--")
	{
		$cat[CDT3]="<!--";	$cat[CDT4]="-->";
	}
	if(get_upload_info($cat[cat_id],"category","",0,$up)>0)
	{
	  $cat=array_merge($cat,$up);
	}
	foreach($cat as $k=>$v)
	{
	  $t->set_var(array("$k"=>$v,));
	}
	$SQL="SELECT cat_id,cat_title FROM category WHERE cat_active='1' AND cat_p_cat_id='$cat[cat_id]' ORDER BY rand() ASC LIMIT 0,3";
	eq($SQL,$rs);
	$t->set_block('MyFileHandle', 'AccessBlockCategoryMatrixList', 'ABlockList');
	while($data=mfa($rs))
	{
		$data[cat_title]=short_txt($data[cat_title],50);
		foreach($data as $k=>$v)
		{
		  $t->set_var(array("sub_$k"=>$v,));
		}
	  $t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);	
	}
	$t->set_var(array("SVP"=>$SVP,));

	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
