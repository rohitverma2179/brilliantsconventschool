function get_cat_list_admin($sel_id,&$option,$show_all=0,$show_parent=0,$show_select=0,$con="")
{
	
	$sel="";	$option=""; $sep="";
	 if(!is_array($sel_id))    {	$sel_id=array($sel_id);    }
    $SQL = "SELECT * FROM category WHERE cat_p_cat_id=0 ORDER BY cat_title";
    eq($SQL,$rs);
    while($data = mfa($rs))
    {	
		
		 if(in_array($data[cat_id],$sel_id)){$sel="selected";$ss=1;}
       
		//echo $sel_id." ".$data[cat_id]." ".$sel."<br>";
        $option.="<option value=\"$data[cat_id]\" $sel class='pcat'>$data[cat_title]</option>";
       // $option.="<optgroup label=".$data[cat_title].">";
        if(grc("category","WHERE cat_p_cat_id='$data[cat_id]'")>0)
		{
			$option.=get_category_child_node($data[cat_id],$sel_id,$sep);
		}
        //$option.="</optgroup>";
		$option.="</option>";
        $sel="";
    }

    $sel="";
    if($ss==0 and $show_all==1)
    {
        $sel="selected";
        $ss=1;
    }

    if($show_all==1)
    {
        $option="<option value=\"-2\" $sel>".All."</option>".$option;
    }
    if ( $show_select==1)
    {
        $option="<option value=\"-1\" selected>Please Select</option>".$option;
    }
    if ($show_parent==1)
    {
        $option="<option value=\"0\" selected>-Parent-</option>".$option;
    }
}
#####################################
function get_category_child_node($cat_id,$sel_id,$sep)
{
	//$sep=str_replace("-","&nbsp;",$sep);
	 if(!is_array($sel_id))    {	$sel_id=array($sel_id);    }
	$sep.="&nbsp;--";
	$option="";	
    $SQL = "SELECT * FROM category WHERE cat_p_cat_id='$cat_id' ORDER BY cat_title";
	eq($SQL,$rs1);
	while($data=mfa($rs1))
	{
		$sel="";
		 if(in_array($data[cat_id],$sel_id)){$sel="selected";$ss=1;}
		$option.="<option value=\"$data[cat_id]\"$sel>$sep $data[cat_title]</option>";
		if(grc("category","WHERE cat_p_cat_id='$data[cat_id]'")>0)
		{
			$option.=get_category_child_node($data[cat_id],$sel_id,$sep);
		}
	}
	return $option;
}
#####################################################
function get_cat_list($sel_id,&$option,$show_parent=0,$show_child=1,$parent_readonly=1,$con="")
{
	

	$option=""; $sel=""; $ss=0;
	$SQL = "SELECT * FROM category WHERE 1 $con ORDER BY cat_title";
	eq($SQL,$rs);
	while($data=mfa($rs))
	{
		$sel="";
		if($parent_readonly==1)
		{
			$option.="<optgroup label='$data[cat_title]'>";
		}
		else
		{
			if($data[cat_id]==$sel_id)
			{
				$ss=1;
				$sel="selected";
			}
			$option.="<option value='$data[cat_id]' $sel>$data[cat_title]</option>";
		}
			if($show_child==1)
			{
				$SQL = "SELECT * FROM category WHERE cat_p_cat_id='$data[cat_id]' ORDER BY cat_title";
				eq($SQL,$rs1);
				while($data1=mfa($rs1))
				{
					$sel="";
					if($data1[cat_id]==$sel_id)
					{
						$ss=1;
						$sel="selected";
					}

					$option.="<option value='$data1[cat_id]' $sel>--$data1[cat_title]</option>";
				}
			}

		if($parent_readonly==1)
		{
			$option.="</optgroup>";
		}
	}

	if($show_parent==1)
	{
		$sel="";
		if($ss==0)
		{
			$sel="selected";
		}

		$option="<option value='0' $sel>-Parent Category-</option>$option";
	}
}


###########################################

function xml_create_tag($xml,$tag_nm)
{
return "<tag id=\"$tag_nm\">".htmlspecialchars($xml)."</tag>";
}

###############################################

function parse_xml_js($xml="",$print=1)
{
global $SUP;
global $AdminEmail;
$xml=<<<EOM
<?xml version='1.0' encoding='ISO-8859-1'?>
<ROOT>
$xml
</ROOT>
EOM;
$handle=fopen("a.xml","w");
fputs($handle,$xml);
fclose($handle);
	if($print==1)
	{
	header("Content-type: text/xml");
	print $xml;
	return 1;
	}
return $xml;
}
