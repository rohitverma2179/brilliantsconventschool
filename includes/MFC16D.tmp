function set_make_product($mk_id=0)
{
	$con="";
	$con1="";
	if($mak_id>0)
	{
	  $con=" WHERE mk_id='$mk_id'";
	}

	$SQL="SELECT * FROM make $con";
	eq($SQL,$rs);
	while($data=mfa($rs))
	{
		$total=0;
		$total=grc("product_make","WHERE pm_mk_id='$data[mk_id]'");
		$SQL2="UPDATE make SET mk_parts_count='$total' WHERE mk_id='$data[mk_id]'";
		eq($SQL2,$rs2);
	}
}
#############################################
function set_dealer_show($dl_id)
{
	$dt=time();
	gri("dealer","WHERE dl_id='$dl_id'","dl_id, dl_type, dl_is_paid, dl_contract_date, dl_contract_expiry_date, dl_active",$dl);
	//echo date("m/d/Y",$dt)." ".$dl[dl_contract_date]." ".($dl[dl_contract_date]<=$dt)." ".date("m/d/Y",$dl[dl_contract_expiry_date])." ".($dl[dl_contract_expiry_date]>$dt);
	if($dl[dl_type]==0)
	{
		if($dl[dl_is_paid]==1 && $dl[dl_contract_date]<=$dt && $dl[dl_contract_expiry_date]>$dt && $dl[dl_active]==1)
		{
		 	 $SQL="UPDATE dealer SET
		  		   dl_can_show='1'
				   WHERE dl_id='$dl[dl_id]'";
		  	 eq($SQL,$rs);
		}else{
			$SQL="UPDATE dealer SET
		  		  dl_can_show='0'
				  WHERE dl_id='$dl[dl_id]'";
		 	 eq($SQL,$rs);
		}
	}else{
		if($dl[dl_active]==1)
		{
		 	 $SQL="UPDATE dealer SET
		  		   dl_can_show='1'
				   WHERE dl_id='$dl[dl_id]'";
		  	 eq($SQL,$rs);
		}else{
			$SQL="UPDATE dealer SET
		  		  dl_can_show='0'
				  WHERE dl_id='$dl[dl_id]'";
		 	 eq($SQL,$rs);
		}
	}
	$SQL="SELECT prod_id FROM product WHERE prod_dl_id='$dl[dl_id]'";
	$tot=eq($SQL,$rs);
	if($tot>0)
	{
		while($data=mfa($rs))
		{
			set_product_show($data[prod_id]);
		}
	}
	
}
##################################
function set_product_show($prod_id)
{
	$dt=time();
	gri("product,dealer","WHERE prod_dl_id=dl_id AND prod_id='$prod_id'","prod_id, prod_active, dl_type, dl_is_paid, dl_contract_date, dl_contract_expiry_date, dl_active",$prod);
	if($prod[dl_type]==1)
	{
		/*if($prod[prod_is_paid]==1 && $prod[prod_expiry_date]>$dt && $prod[prod_active]==1)
		{
		 	 $SQL="UPDATE product SET
		  		   prod_can_show='1'
				   WHERE prod_id='$prod[prod_id]'";
		  	 eq($SQL,$rs);
		}else{
			$SQL="UPDATE product SET
		  		  prod_can_show='0'
				  WHERE prod_id='$prod[prod_id]'";
		 	 eq($SQL,$rs);
		}*/
	}else{
		if($prod[dl_is_paid]==1 && $prod[dl_contract_date]<=$dt && $prod[dl_contract_expiry_date]>$dt && $prod[dl_active]==1 && $prod[prod_active]==1)
		{
		 	 $SQL="UPDATE product SET
		  		   prod_can_show='1'
				   WHERE prod_id='$prod[prod_id]'";
		  	 eq($SQL,$rs);
		}else{
			$SQL="UPDATE product SET
		  		  prod_can_show='0'
				  WHERE prod_id='$prod[prod_id]'";
		 	 eq($SQL,$rs);
		}
	}
}
####################################

function get_subcat_matrix($ary)
{
	if(sizeof($ary)==0)
	{
		return "";
	}
	
	global $SVP;
	$m=0;
	$cols=5;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","subcat_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockCategoryMatrixList', 'ABlockList');

	$i=0;
	
	foreach($ary as $k=>$v)
	{
		$t->set_var(array("cat_matrix_".$i%$cols=>get_subcat_source($v),"m_".$m%$cols=>$m));
		if($v>0)
		{	$style_txt="";
			$class_txt="catbox";
			if(get_upload_info($v,"category","",0,$up)>0)
			{
				$style_txt.="style=\"background:url(".$up[up_view_path_thumb].") no-repeat right bottom;\"";
			}
			$t->set_var(array("show_".$m=>$style_txt,"class_".$m=>$class_txt,
							  "cbox_".$m=>'background:url(images/top_box_bg.png) no-repeat;',
								));
		}
		 
		if($i%$cols==$cols_ AND $i>0)
		{
			$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);		
		}
		$i++;
		$m++;
		
	}
	$n=$i;
	if($i>0 AND $i%$cols!=$cols)
	{
		$cat_class="";
		
		for($j=$i;$i>0;$j++)
		{
			$t->set_var(array("cat_matrix_".$j%$cols=>"","m_".$m%$cols=>$m,));
			if($j%$cols==$cols_)
			{
				$t->set_var(array("show_".$m=>"",));
				$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);	
				$i=0;
			}
			$m++;
		}
	}
	//hide unused columns in a row
	if($n%$cols>0 && $n%$cols<$cols)
	{		
		for($k=$n;$k<$m;$k++)
		{			
			$t->set_var(array("show_".$k=>"","class_".$k=>"",));
		}
		
	}
	$t->set_var(array(	"title"=>$title,
						"SVP"=>$SVP,
						));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
