function get_make_matrix($ary)
{
	if(sizeof($ary)==0)
	{
		return "";
	}

	global $SVP;
	$cols=4;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","make_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockMakeMatrixList', 'ABlockList');

	$i=0;
	foreach($ary as $k=>$v)
	{
		$t->set_var(array("make_matrix_".$i%$cols=>get_make_source($v),));
		if($i%$cols==$cols_ AND $i>0)
		{
			$t->Parse('ABlockList', 'AccessBlockMakeMatrixList', true);		
		}
		$i++;
	}
	if($i>0 AND $i%$cols!=$cols && count($ary)%$cols!=0)
	{
		for($j=$i;$i>0;$j++)
		{
			$t->set_var(array("make_matrix_".$j%$cols=>"",));
			if($j%$cols==$cols_)
			{
				$t->Parse('ABlockList', 'AccessBlockMakeMatrixList', true);	
				$i=0;
			}
		}
	}

	$t->set_var(array("title"=>$title,
					  "SVP"=>$SVP,
						));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
