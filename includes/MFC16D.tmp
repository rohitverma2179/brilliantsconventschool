function get_dealer_subcat_matrix($ary)
{
	if(sizeof($ary)==0)
	{
		return "";
	}
	global $SVP;
	$cols=5;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","dealer_subcat_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockCategoryMatrixList', 'ABlockList');

	$i=0;
	foreach($ary as $k=>$v)
	{
		$t->set_var(array("cat_matrix_".$i%$cols=>get_dealer_subcat_source($v),));
		$up=array();
		if(get_upload_info($v,"category","",0,$up)>0)
		{
		  	foreach($up as $k=>$v)
			{
			  $t->set_var(array("$k"=>$v,));
			}
		}
		
		
		if($i%$cols==$cols_ AND $i>0)
		{
			$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);		
		}
		$i++;
	}

	if($i>0 AND $i%$cols!=$cols)
	{
		for($j=$i;$i>0;$j++)
		{
			$t->set_var(array("cat_matrix_".$j%$cols=>"",));
			if($j%$cols==$cols_)
			{
				$t->Parse('ABlockList', 'AccessBlockCategoryMatrixList', true);	
				$i=0;
			}
		}
	}

	$t->set_var(array("title"=>$title,
					  "SVP"=>$SVP,
						));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
