function get_value_ary($table,$col,$con="")
{
    $ary=array();
    $SQL = "SELECT $col FROM $table $con";
    eq($SQL,$rs);
    while($data=mfa($rs))
    {
	array_push($ary,$data[$col]);
	}
    return $ary;
}
