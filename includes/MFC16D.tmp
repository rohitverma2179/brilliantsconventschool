########################################
function get_page_matrix($title, $ary)
{
	global $SVP;
	if(!sizeof($ary))
	{
		return "";
	}
	
	$cols=3;
	$cols_=$cols-1;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","title_matrix.htm");
	$t->set_block('MyFileHandle', 'AccessBlockTitleMatrixList', 'ABlockList');
	$i=0;
	foreach($ary as $k=>$v)
	{
		$t->set_var(array("title_matrix_".$i%$cols=>get_page_source($v),));
		if($i%$cols==$cols_ AND $i>0)
		{
			$t->Parse('ABlockList', 'AccessBlockTitleMatrixList', true);		
		}
		$i++;
	}
	if($i>0 AND $i%$cols!=$cols AND $i%$cols!=0)
	{
		for($j=$i;$i>0;$j++)
		{
			$t->set_var(array("title_matrix_".$j%$cols=>"",));
			if($j%$cols==$cols_)
			{
				$t->Parse('ABlockList', 'AccessBlockTitleMatrixList', true);	
				$i=0;
			}
		}
	}
	$t->set_var(array("title"=>$title,"SVP"=>$SVP,));
	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}
