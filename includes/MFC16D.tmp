function get_new_seat_option_list($sel_id,&$option,$show_all=0,$con="",$show_select=1,$select_txt="Please Select")
{
	$table="competition_seat,seat";
	$id_col="cs_id";
	$val_col=array("seat_title","cs_seat_price_");
    if(!is_array($sel_id))    {	$sel_id=array($sel_id);    }
    $SQL = "SELECT * FROM $table $con "; 
   eq($SQL,$rs);
    $ss=0;
    while($data = mfa($rs))
    {
		$show_val="";
		if(is_array($val_col))
		{
			foreach($val_col as $val)
			{
			  if($val=="cs_seat_price_")
			  {
			  	if($data[cs_quantity]>0 && grc("cart_item","WHERE ci_seat_id='$data[cs_seat_id]' AND ci_cmp_id='$data[cs_cmp_id]'")>=$data[cs_quantity])
				{
					$data[$val]=" Full";
					$data[$id_col]="-1";
				}
				if($data[cs_quantity]==0)
				{
					$data[$val]=" Full";
					$data[$id_col]="-1";
				}
				
			  }
			 $show_val.=" ".$data[$val];
			}
		  	$show_val=substr($show_val,1);
		}else{
		  	$show_val=$data[$val_col];
		}
        if(in_array($data[$id_col],$sel_id)){$sel="selected";$ss=1;}
        $option.="<option value=\"$data[$id_col]\"$sel>$show_val</option>";
        $sel="";
    }
    $sel="";
    
    if($ss==0 and $show_all==1)
    {
        $sel="selected";
        $ss=1;
    }
    if($show_all==1)
    {
        $option="<option value=\"-2\"$sel>".All."</option>".$option;
    }
    if ($ss==0 AND $show_select==1)
    {
        $option="<option value=\"-1\" selected>$select_txt</option>".$option;
    }
    if ($parent==1)
    {
        $option="<option value=\"0\" selected>-Parent-</option>".$option;
    }

   
}

