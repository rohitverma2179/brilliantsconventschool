function get_subcat_source($cat_id)
{
	global $SVP;
	$t=new Template("templates");
	$t->set_file("MyFileHandle","subcat_source.htm");
	gri("category","WHERE cat_id='$cat_id' AND cat_active='1'","",$cat);
	$cat[cat_title]=short_txt($cat[cat_title],40);
	foreach($cat as $k=>$v)
	{
	  $t->set_var(array("$k"=>$v,));
	}
	$SQL="SELECT cat_id,cat_title FROM category WHERE cat_active='1' AND cat_p_cat_id='$cat[cat_id]' ORDER BY rand() ASC LIMIT 0,4";
	eq($SQL,$rs);
	
	$t->set_block('MyFileHandle', 'AccessBlockSubCategoryList', 'ABlockList');
	while($data=mfa($rs))
	{
		foreach($data as $k=>$v)
		{
		  $t->set_var(array("sub_$k"=>$v,));
		}
	  $t->Parse('ABlockList', 'AccessBlockSubCategoryList', true);	
	}
	$t->set_var(array("SVP"=>$SVP,));

	$t->parse("MyOutPut","MyFileHandle");
	return $t->get("MyOutPut");
}

